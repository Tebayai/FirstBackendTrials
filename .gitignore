# Dépendances
# Jamais versionné : ça se réinstalle avec "npm install" grâce au package-lock.json
node_modules/

# Variables d'environnement (mots de passe, clés d'API, URL de base de données)
# LE fichier à ne surtout jamais pousser sur GitHub
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Fichiers générés au build / à l'exécution
dist/
build/
coverage/
*.pid
*.pid.lock

# Caches d'outils
.npm/
.cache/
.eslintcache
.node_repl_history

# Fichiers créés par le système d'exploitation
.DS_Store
Thumbs.db

# Fichiers d'éditeur
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Bases de données locales
*.sqlite
*.sqlite3
*.db
